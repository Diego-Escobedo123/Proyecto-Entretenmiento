// Esquema de la base de datos. Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  profile      Profile?
  entries      MediaEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

/// Datos editables del perfil. 1:1 con User (el frontend lo trata como entidad aparte).
model Profile {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  handle      String   @default("")
  avatar      String?
  tagline     String   @default("Tu identidad cultural")
  quote       String   @default("Cada obra cuenta una historia. Juntas cuentan la tuya.")
  memberSince Int?
  /// Visibilidad del perfil público (GET /users/:id). Si es `false`, los demás
  /// sólo ven nombre y avatar; las reseñas siguen visibles en cada obra.
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

/// Una "obra" registrada por el usuario (película, libro, juego, álbum).
model MediaEntry {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  type        String // 'movie' | 'book' | 'game' | 'music'
  title       String
  creator     String   @default("")
  status      String   @default("want") // 'want' | 'in-progress' | 'completed'
  year        Int?
  rating      Float?
  progress    Int?
  favorite    Boolean  @default(false)
  genres      String[] @default([]) // array nativo de Postgres
  /// Comentario que acompaña a la calificación. Siempre público: lo ven los
  /// demás usuarios al buscar la obra.
  review      String   @default("")
  /// Notas personales. Privadas por defecto; si `notesPublic`, se muestran
  /// sólo en el perfil público del usuario (nunca en las reseñas de la obra).
  notes       String   @default("")
  notesPublic Boolean  @default(false)
  cover       String?
  /// Id en el catálogo externo (p. ej. "tmdb:438631"). Identifica la misma
  /// obra entre usuarios; `null` en obras ingresadas manualmente.
  externalId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([type, externalId])
}

/// Contenido curado para la pantalla de descubrimiento (joyas escondidas y
/// ganadores de premios). No pertenece a ningún usuario: es catálogo global.
model DiscoverItem {
  id          String   @id @default(cuid())
  type        String // 'movie' | 'book' | 'game' | 'music'
  title       String
  cover       String
  description String   @default("")
  year        Int?
  rating      Float?
  genres      String[] @default([])
  /// Nombre del premio. `null` => candidato a "joya escondida"; no nulo => ganador de premio.
  award       String?
  /// Marca la joya escondida destacada (tarjeta grande) de la sección.
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([award])
}
