# Copiar a .env y ajustar. .env NO se versiona.

# Base de datos PostgreSQL.
# Local con Docker: docker run --name mosaic-pg -e POSTGRES_PASSWORD=postgres \
#   -e POSTGRES_DB=mosaic -p 5432:5432 -d postgres:17
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mosaic?schema=public"

# Si usás una Postgres serverless (Neon, Supabase) con pooler, además:
# DATABASE_URL="postgresql://.../mosaic?pgbouncer=true"
# DIRECT_URL="postgresql://.../mosaic"   (y agregar directUrl al datasource del schema)

# Firma de los JWT. En producción usar un valor largo y aleatorio.
JWT_SECRET="dev-secret-change-me"

# Puerto del servidor
PORT=3000

# Orígenes permitidos por CORS (separados por coma). El dev server de Vite es 5173.
CORS_ORIGIN="http://localhost:5173"
