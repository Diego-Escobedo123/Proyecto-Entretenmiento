# Copiar a .env y ajustar. .env NO se versiona.

# Base de datos PostgreSQL.
# Local con Docker: docker run --name mosaic-pg -e POSTGRES_PASSWORD=postgres \
#   -e POSTGRES_DB=mosaic -p 5432:5432 -d postgres:17
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mosaic?schema=public"

# Si usás una Postgres serverless (Neon, Supabase) con pooler, además:
# DATABASE_URL="postgresql://.../mosaic?pgbouncer=true"
# DIRECT_URL="postgresql://.../mosaic"   (y agregar directUrl al datasource del schema)

# Firma de los JWT. En producción usar un valor largo y aleatorio.
JWT_SECRET="dev-secret-change-me"

# Client ID de OAuth de Google (el mismo que VITE_GOOGLE_CLIENT_ID del frontend).
# Si queda vacío, POST /auth/google responde 503 y el resto funciona igual.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""

# Correos (verificación de cuenta) con Resend. API key: https://resend.com/api-keys
# Si queda vacía no se envía nada: el enlace de verificación se imprime en la
# consola del servidor, así se puede probar en local sin cuenta de Resend.
RESEND_API_KEY=""
# Remitente. onboarding@resend.dev solo entrega al correo dueño de la cuenta de
# Resend; para mandar a cualquiera hay que verificar un dominio propio.
EMAIL_FROM="Mosaic <onboarding@resend.dev>"
# URL pública del frontend: los enlaces del correo apuntan a APP_URL/verify-email.
APP_URL="http://localhost:5173"

# Puerto del servidor
PORT=3000

# Orígenes permitidos por CORS (separados por coma). El dev server de Vite es 5173.
CORS_ORIGIN="http://localhost:5173"

# APIs externas para /search (autocompletar al agregar una obra) y /discover.
# Google Books e iTunes Search no piden key. Si falta una key, esa búsqueda
# devuelve `available: false` en vez de romper — el resto sigue funcionando.

# TMDB (películas). Key gratis e instantánea: https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# RAWG (juegos). Key gratis: https://rawg.io/apidocs
RAWG_API_KEY=""

# Google Books (libros). Opcional: funciona sin key pero con cuota compartida
# que rate-limita rápido (429). Con key propia (gratis) la cuota es individual.
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=""
