# Copiar a .env y ajustar. .env NO se versiona.
VITE_API_URL=http://localhost:3000

# Client ID de OAuth de Google (el mismo que GOOGLE_CLIENT_ID del backend).
# Si queda vacío, el login muestra el botón de Google como no disponible.
VITE_GOOGLE_CLIENT_ID=

# Analítica con PostHog (Project settings → Project API key, empieza con phc_).
# Si queda vacío, la app funciona igual pero no manda eventos.
VITE_POSTHOG_KEY=
# https://us.i.posthog.com (proyecto en EE. UU.) o https://eu.i.posthog.com (Europa).
VITE_POSTHOG_HOST=https://us.i.posthog.com